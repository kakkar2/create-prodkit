{
  "name": "create-prodkit",
  "version": "1.0.0",
  "description": "CLI to scaffold a production-ready Next.js project",
  "main": "src/cli.js",
  "bin": {
    "create-prodkit": "./bin/index.js"
  },
  "type": "module",
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "dev": "node bin/index.js",
    "prepare": "husky",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major"
  },
  "lint-staged": {
    "**/*.js": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "release-it": "^17.0.0",
    "@release-it/conventional-changelog": "^8.0.0"
  },
  "keywords": [
    "nextjs",
    "cli",
    "starter",
    "scaffold",
    "shadcn",
    "tailwind"
  ],
  "license": "MIT",
  "author": "Lalit Kakkar <lalitkakkar50@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/kakkar2/create-next-starter.git"
  },
  "homepage": "https://github.com/kakkar2/create-next-starter#readme",
  "bugs": {
    "url": "https://github.com/kakkar2/create-next-starter/issues"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.3.5",
    "inquirer": "^9.3.8",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
